            stroke.Transparency = 0.5
            
            table.insert(Window.ThemedElements.Bg, tglBtn)
            table.insert(Window.ThemedElements.Text, tglBtn)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local switchBg = Instance.new("Frame")
            switchBg.Size = UDim2.new(0, 36, 0, 20)
            switchBg.Position = UDim2.new(1, -46, 0.5, -10)
            switchBg.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
            switchBg.Parent = tglBtn
            Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 14, 0, 14)
            knob.Position = UDim2.new(0, 3, 0.5, -7)
            knob.Parent = switchBg
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local Element = {Value = default}
            local tData = {bg = switchBg, knob = knob, state = Element.Value}
            table.insert(Window.ActiveToggles, tData)

            local function fire()
                tData.state = Element.Value
                if Element.Value then
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Window.CurrentTheme.Main}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -17, 0.5, -7), BackgroundColor3 = Color3.new(1,1,1)}):Play()
                else
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 22, 35)}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 3, 0.5, -7), BackgroundColor3 = Window.CurrentTheme.SubText}):Play()
                end
                callback(Element.Value)
            end

            function Element:Set(val)
                Element.Value = val
                fire()
            end

            tglBtn.MouseButton1Click:Connect(function()
                Element.Value = not Element.Value
                fire()
            end)
            
            Window.Flags[flag] = Element
            Window:ApplyTheme()
            fire()
            
            return Element
        end

        function Tab:CreateSlider(opts)
            local title = opts.Name or "Slider"
