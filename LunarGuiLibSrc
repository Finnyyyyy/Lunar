            local dragging = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                Element:Set(value)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)

            Window.Flags[flag] = Element
            Element:Set(default)

            return Element
        end

        function Tab:CreateDropdown(opts)
            local title = opts.Name or "Dropdown"
            local options = opts.Options or {}
            local default = opts.Default or options[1]
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end

            local ddBtn = Instance.new("TextButton")
            ddBtn.Size = UDim2.new(1, 0, 0, 30)
            ddBtn.BackgroundTransparency = 0.2
            ddBtn.Text = "  " .. title .. ": " .. tostring(default)
            ddBtn.TextXAlignment = Enum.TextXAlignment.Left
            ddBtn.TextSize = 13
            ddBtn.Parent = Page
            applyCleanTextSettings(ddBtn)

            Instance.new("UICorner", ddBtn).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(ddBtn)
            
            table.insert(Window.ThemedElements.Bg, ddBtn)
            table.insert(Window.ThemedElements.Text, ddBtn)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 1, 0)
            arrow.Position = UDim2.new(1, -25, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextSize = 11
            arrow.Parent = ddBtn
            applyCleanTextSettings(arrow)

            table.insert(Window.ThemedElements.SubText, arrow)

            local listFrame = Instance.new("ScrollingFrame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.BackgroundTransparency = 0.2
            listFrame.BorderSizePixel = 0
            listFrame.ScrollBarThickness = 2
            listFrame.Visible = false
            listFrame.ClipsDescendants = true
            listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
            listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            listFrame.Parent = Page
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
            local listStroke = makeStroke(listFrame)
            
            table.insert(Window.ThemedElements.Bg, listFrame)
            table.insert(Window.ThemedElements.StrokeMain, listStroke)

            local listLayout = Instance.new("UIListLayout", listFrame)
            listLayout.Padding = UDim.new(0, 2)

            local isOpen = false
            local animInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

            local function close()
                isOpen = false
                arrow.Text = "▼"
                local tween = TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, 0)})
                tween:Play()
                tween.Completed:Once(function() if not isOpen then listFrame.Visible = false end end)
            end

            ddBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "▲" or "▼"
                if isOpen then
                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                    listFrame.Visible = true
                    TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, math.clamp(#options * 26, 0, 100))}):Play()
                else
                    close()
                end
            end)

            local Element = {Value = default, Options = options}

            local function populateList()
                for _, child in ipairs(listFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end

                for _, opt in ipairs(Element.Options) do
                    local optBtn = Instance.new("TextButton")
                    optBtn.Size = UDim2.new(1, -8, 0, 24)
                    optBtn.BackgroundTransparency = 1
                    optBtn.Text = "  " .. tostring(opt)
                    optBtn.TextSize = 12
                    optBtn.TextXAlignment = Enum.TextXAlignment.Left
                    optBtn.Parent = listFrame
                    applyCleanTextSettings(optBtn)

                    table.insert(Window.ThemedElements.Text, optBtn)

                    optBtn.MouseButton1Click:Connect(function()
                        Element:Set(opt)
                        close()
                    end)
                end
                Window:ApplyTheme()
            end

            function Element:Set(val)
                Element.Value = val
                ddBtn.Text = "  " .. title .. ": " .. tostring(val)
                callback(Element.Value)
            end

            function Element:Refresh(newOptions)
                Element.Options = newOptions
                populateList()
            end

            populateList()
            Window.Flags[flag] = Element
            Element:Set(default)
            
            return Element
        end

        return Tab
    end

    function Window:BuildSettingsTab()
        local SettingsTab = self:CreateTab("Settings")
        
        local themesList = {}
        for _, t in ipairs(LunarLib.Themes) do table.insert(themesList, t.Name) end

        SettingsTab:CreateDropdown({
            Name = "Select Theme",
            Options = themesList,
            Default = Window.CurrentTheme.Name,
            Callback = function(selected)
                for i, t in ipairs(LunarLib.Themes) do
                    if t.Name == selected then
                        self.ThemeIndex = i
                        self.CurrentTheme = LunarLib.Themes[i]
                        self:ApplyTheme()
                        break
                    end
                end
            end
        })

        local configNameBox
        local configDropdown
        
        local function getConfigs()
            local list = {}
            if isfolder and isfolder(self.Folder) then
                for _, file in ipairs(listfiles(self.Folder)) do
                    if file:match("%.json$") then
                        table.insert(list, file:match("([^/%\\]+)%.json$"))
                    end
                end
            end
            if #list == 0 then table.insert(list, "None") end
            return list
        end

        if makefolder and not isfolder(self.Folder) then
            makefolder(self.Folder)
        end

        configNameBox = SettingsTab:CreateTextbox({
            Name = "Config Name",
            Placeholder = "Enter config name..."
        })

        SettingsTab:CreateButton({
            Name = "Save Config",
            Callback = function()
                local name = configNameBox.Value
                if name == "" then return end
                
                local data = {}
                for flagName, element in pairs(self.Flags) do
                    if flagName ~= "Select Theme" and flagName ~= "Config Name" and flagName ~= "Select Config" then
                        data[flagName] = element.Value
                    end
                end
                
                if writefile then
                    writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(name)
                end
            end
        })

        configDropdown = SettingsTab:CreateDropdown({
            Name = "Select Config",
            Options = getConfigs(),
            Callback = function() end
        })

        SettingsTab:CreateButton({
            Name = "Overwrite Config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil or name == "" then return end
                
                local data = {}
                for flagName, element in pairs(self.Flags) do
                    if flagName ~= "Select Theme" and flagName ~= "Config Name" and flagName ~= "Select Config" then
                        data[flagName] = element.Value
                    end
                end
                
                if writefile then
                    writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(name)
                end
            end
        })

        SettingsTab:CreateButton({
            Name = "Load Config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil then return end
                
                local path = self.Folder .. "/" .. name .. ".json"
                if isfile and isfile(path) then
                    local success, decoded = pcall(function()
                        return HttpService:JSONDecode(readfile(path))
                    end)
                    if success and type(decoded) == "table" then
                        for flagName, value in pairs(decoded) do
                            if self.Flags[flagName] then
                                pcall(function()
                                    self.Flags[flagName]:Set(value)
                                end)
                            end
                        end
                    end
                end
            end
        })

        SettingsTab:CreateButton({
            Name = "Delete Config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil then return end
                local path = self.Folder .. "/" .. name .. ".json"
                if isfile and isfile(path) and delfile then
                    delfile(path)
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(getConfigs()[1])
                end
            end
        })
        
        SettingsTab:CreateButton({
            Name = "Unload UI",
            Callback = function()
                ScreenGui:Destroy()
            end
        })
        
        return SettingsTab
    end

    return Window
end

return LunarLib
