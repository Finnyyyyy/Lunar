            table.insert(Window.ThemedElements.Bg, BtnFrame)
            table.insert(Window.ThemedElements.Text, BtnFrame)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            BtnFrame.MouseButton1Click:Connect(callback)
        end

        function Tab:CreateTextbox(opts)
            local title = opts.Name or "Textbox"
            local placeholder = opts.Placeholder or ""
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end

            local boxFrame = Instance.new("Frame")
            boxFrame.Size = UDim2.new(1, 0, 0, 30)
            boxFrame.BackgroundTransparency = 0.2
            boxFrame.Parent = Page
            Instance.new("UICorner", boxFrame).CornerRadius = UDim.new(0, 6)
