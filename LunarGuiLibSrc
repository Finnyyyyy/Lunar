                picker.AnchorPoint = Vector2.new(0.5, 0.5)
                picker.Position = UDim2.new(0.5, 0, 0.5, 0)
                picker.BackgroundColor3 = Color3.new(1,1,1)
                picker.Parent = wheel
                Instance.new("UICorner", picker).CornerRadius = UDim.new(1, 0)
                makeStroke(picker)

                local darkPicker = Instance.new("Frame")
                darkPicker.Size = UDim2.new(0, 20, 0, 100)
                darkPicker.Position = UDim2.new(0, 120, 0, 10)
                darkPicker.BackgroundColor3 = Color3.new(1, 1, 1)
                darkPicker.Parent = wheelContainer
                Instance.new("UICorner", darkPicker).CornerRadius = UDim.new(0, 4)
                
                local uiGradient = Instance.new("UIGradient")
                uiGradient.Rotation = 90
                uiGradient.Color = ColorSequence.new(Element.Color, Color3.new(0, 0, 0))
                uiGradient.Parent = darkPicker

                local darkSlider = Instance.new("Frame")
                darkSlider.Size = UDim2.new(1.2, 0, 0, 4)
                darkSlider.AnchorPoint = Vector2.new(0.5, 0.5)
                darkSlider.Position = UDim2.new(0.5, 0, 0, 0)
                darkSlider.BackgroundColor3 = Color3.new(1,1,1)
                darkSlider.Parent = darkPicker

                colorPreview.MouseButton1Click:Connect(function()
                    wheelContainer.Visible = not wheelContainer.Visible
                end)

                local h, s, v = Element.Color:ToHSV()
                
                local function updateColor()
                    Element.Color = Color3.fromHSV(h, s, v)
                    colorPreview.BackgroundColor3 = Element.Color
                    uiGradient.Color = ColorSequence.new(Color3.fromHSV(h, s, 1), Color3.new(0, 0, 0))
                    if hasColor then callback(Element.Value, Element.Color) end
                end

                local draggingWheel = false
                wheel.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingWheel = true
                    end
                end)

                local draggingDark = false
                darkPicker.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingDark = true
                    end
                end)

                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        draggingWheel = false
                        draggingDark = false
                    end
                end)

                UserInputService.InputChanged:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                        if draggingWheel then
                            local diffX = input.Position.X - (wheel.AbsolutePosition.X + wheel.AbsoluteSize.X / 2)
                            local diffY = input.Position.Y - (wheel.AbsolutePosition.Y + wheel.AbsoluteSize.Y / 2)
                            h = (math.pi - math.atan2(diffY, diffX)) / (math.pi * 2)
                            local radius = wheel.AbsoluteSize.X / 2
                            s = math.clamp((Vector2.new(diffX, diffY).Magnitude) / radius, 0, 1)
                            
                            local angle = 360 * h
                            local r = radius * s
                            picker.Position = UDim2.new(0.5, 0, 0.5, 0) + UDim2.fromOffset(r * math.cos(math.rad(angle)), -r * math.sin(math.rad(angle)))
                            updateColor()
                        elseif draggingDark then
                            local value = 1 - ((input.Position.Y - darkPicker.AbsolutePosition.Y) / darkPicker.AbsoluteSize.Y)
                            v = math.clamp(value, 0, 1)
                            darkSlider.Position = UDim2.new(0.5, 0, 1 - v, 0)
                            updateColor()
                        end
                    end
                end)
            end

            local function fire()
                tData.state = Element.Value
                if Element.Value then
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Window.CurrentTheme.Main}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Color3.new(1,1,1)}):Play()
                else
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 22, 35)}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Window.CurrentTheme.SubText}):Play()
                end
                
                if hasColor then
                    callback(Element.Value, Element.Color)
                else
                    callback(Element.Value)
                end
            end

            function Element:Set(val)
                Element.Value = val
                fire()
            end

            tglBtn.MouseButton1Click:Connect(function()
                Element.Value = not Element.Value
                fire()
            end)
            
            Window.Flags[flag] = Element
            Window:ApplyTheme()
            fire()
            return Element
        end

        function Tab:CreateSlider(opts)
            local title = opts.Name or "Slider"
            local desc = opts.Description or ""
            local min = opts.Min or 0
            local max = opts.Max or 100
            local default = opts.Default or min
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end

            local sliderFrame = Instance.new("Frame")
            sliderFrame.BackgroundTransparency = 0.2
            sliderFrame.Parent = Page
            Instance.new("UICorner", sliderFrame).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(sliderFrame)
            table.insert(Window.ThemedElements.Bg, sliderFrame)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local height = setupDescription(sliderFrame, title, desc)
            sliderFrame.Size = UDim2.new(1, 0, 0, height + 16)

            local valLabel = Instance.new("TextLabel")
            valLabel.Size = UDim2.new(0, 40, 0, 16)
            valLabel.Position = UDim2.new(1, -48, 0, 7)
            valLabel.BackgroundTransparency = 1
            valLabel.Text = tostring(default)
            valLabel.TextSize = 12
            valLabel.TextXAlignment = Enum.TextXAlignment.Right
            valLabel.Parent = sliderFrame
            applyCleanTextSettings(valLabel, false)
            table.insert(Window.ThemedElements.Text, valLabel)

            local barBg = Instance.new("Frame")
            barBg.Size = UDim2.new(1, -16, 0, 4)
            barBg.Position = UDim2.new(0, 8, 1, -12)
            barBg.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
            barBg.Parent = sliderFrame
            Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

            local barFill = Instance.new("Frame")
            barFill.Size = UDim2.new(0, 0, 1, 0)
            barFill.Parent = barBg
            Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)
            table.insert(Window.ThemedElements.Main, barFill)

            local Element = {Value = default}

            function Element:Set(val)
                Element.Value = math.clamp(val, min, max)
                local pos = (Element.Value - min) / (max - min)
                barFill.Size = UDim2.new(pos, 0, 1, 0)
                valLabel.Text = tostring(Element.Value)
                callback(Element.Value)
            end

            local dragging = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                Element:Set(value)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true
                    updateSlider(input)
                end
            end)

            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = false
                end
            end)

            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)

            Window.Flags[flag] = Element
            Element:Set(default)
            return Element
        end

        function Tab:CreateDropdown(opts)
            local title = opts.Name or "Dropdown"
            local desc = opts.Description or ""
            local options = opts.Options or {}
            local default = opts.Default or options[1]
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end

            local ddBtn = Instance.new("TextButton")
            ddBtn.BackgroundTransparency = 0.2
            ddBtn.Text = ""
            ddBtn.Parent = Page
            Instance.new("UICorner", ddBtn).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(ddBtn)
            table.insert(Window.ThemedElements.Bg, ddBtn)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local height = setupDescription(ddBtn, title .. ": " .. tostring(default), desc)
            
            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 0, 20)
            arrow.Position = UDim2.new(1, -25, 0, (height / 2) - 10)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextSize = 11
            arrow.Parent = ddBtn
            applyCleanTextSettings(arrow, true)
            table.insert(Window.ThemedElements.SubText, arrow)

            local listFrame = Instance.new("ScrollingFrame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.BackgroundTransparency = 0.2
            listFrame.BorderSizePixel = 0
            listFrame.ScrollBarThickness = 2
            listFrame.Visible = false
            listFrame.ClipsDescendants = true
            listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
            listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            listFrame.Parent = Page
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
            local listStroke = makeStroke(listFrame)
            table.insert(Window.ThemedElements.Bg, listFrame)
            table.insert(Window.ThemedElements.StrokeMain, listStroke)

            local listLayout = Instance.new("UIListLayout", listFrame)
            listLayout.Padding = UDim.new(0, 2)

            local isOpen = false
            local animInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

            local function close()
                isOpen = false
                arrow.Text = "▼"
                local tween = TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, 0)})
                tween:Play()
                tween.Completed:Once(function() if not isOpen then listFrame.Visible = false end end)
            end

            ddBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "▲" or "▼"
                if isOpen then
                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                    listFrame.Visible = true
                    TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, math.clamp(#options * 26, 0, 100))}):Play()
                else
                    close()
                end
            end)

            local Element = {Value = default, Options = options}
            local titleLabel = ddBtn:FindFirstChildOfClass("TextLabel")

            local function populateList()
                for _, child in ipairs(listFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, opt in ipairs(Element.Options) do
                    local optBtn = Instance.new("TextButton")
                    optBtn.Size = UDim2.new(1, -8, 0, 24)
                    optBtn.BackgroundTransparency = 1
                    optBtn.Text = "  " .. tostring(opt)
                    optBtn.TextSize = 12
                    optBtn.TextXAlignment = Enum.TextXAlignment.Left
                    optBtn.Parent = listFrame
                    applyCleanTextSettings(optBtn, false)
                    table.insert(Window.ThemedElements.Text, optBtn)

                    optBtn.MouseButton1Click:Connect(function()
                        Element:Set(opt)
                        close()
                    end)
                end
                Window:ApplyTheme()
            end

            function Element:Set(val)
                Element.Value = val
                if titleLabel then titleLabel.Text = title .. ": " .. tostring(val) end
                callback(Element.Value)
            end

            populateList()
            Window.Flags[flag] = Element
            Element:Set(default)
            return Element
        end

        return Tab
    end

    function Window:BuildSettingsTab()
        local SettingsTab = self:CreateTab("Settings")
        
        local themesList = {}
        for _, t in ipairs(LunarLib.Themes) do table.insert(themesList, t.Name) end

        SettingsTab:CreateDropdown({
            Name = "Select Theme",
            Options = themesList,
            Default = Window.CurrentTheme.Name,
            Callback = function(selected)
                for i, t in ipairs(LunarLib.Themes) do
                    if t.Name == selected then
                        self.ThemeIndex = i
                        self.CurrentTheme = LunarLib.Themes[i]
                        self:ApplyTheme()
                        break
                    end
                end
            end
        })
    end

    return Window
end

return LunarLib
