            table.insert(Window.ThemedElements.StrokeMain, stroke)

            SetupDescription(tglBtn, title, desc)

            local RightContainer = Instance.new("Frame")
            RightContainer.Size = UDim2.new(0.5, 0, 1, 0)
            RightContainer.Position = UDim2.new(0.5, -8, 0, 0)
            RightContainer.BackgroundTransparency = 1
            RightContainer.Parent = tglBtn
            
            local RightLayout = Instance.new("UIListLayout", RightContainer)
            RightLayout.FillDirection = Enum.FillDirection.Horizontal
            RightLayout.HorizontalAlignment = Enum.HorizontalAlignment.Right
            RightLayout.VerticalAlignment = Enum.VerticalAlignment.Center
            RightLayout.Padding = UDim.new(0, 8)

            local switchBg = Instance.new("Frame")
            switchBg.Size = UDim2.new(0, 32, 0, 16)
            switchBg.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
            switchBg.Parent = RightContainer
            Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 12, 0, 12)
            knob.Position = UDim2.new(0, 2, 0.5, -6)
            knob.Parent = switchBg
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local Element = {Value = defaultState, Color = defaultColor, Key = defaultKey}
            local tData = {bg = switchBg, knob = knob, state = Element.Value}
            table.insert(Window.ActiveToggles, tData)

            local function fire()
                tData.state = Element.Value
                if Element.Value then
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Window.CurrentTheme.Main}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Color3.new(1,1,1)}):Play()
                else
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 22, 35)}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Window.CurrentTheme.SubText}):Play()
                end
                if opts.Color then callback(Element.Value, Element.Color) else callback(Element.Value) end
            end

            -- Keybind Logic
            if opts.Keybind then
                local KeyBtn = Instance.new("TextButton")
                KeyBtn.Size = UDim2.new(0, 40, 0, 20)
                KeyBtn.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
                KeyBtn.Text = Element.Key and formatKeyName(Element.Key) or "None"
                KeyBtn.TextSize = 11
                KeyBtn.Parent = RightContainer
                Instance.new("UICorner", KeyBtn).CornerRadius = UDim.new(0, 4)
                applyCleanTextSettings(KeyBtn)
                table.insert(Window.ThemedElements.SubText, KeyBtn)

                local binding = false
                KeyBtn.MouseButton1Click:Connect(function()
                    binding = true
                    KeyBtn.Text = "..."
                end)

                UserInputService.InputBegan:Connect(function(input)
                    if binding then
                        if input.UserInputType == Enum.UserInputType.Keyboard or input.UserInputType.Name:find("MouseButton") then
                            local key = (input.UserInputType == Enum.UserInputType.Keyboard) and input.KeyCode or input.UserInputType
                            if key.Name == "Escape" then
                                Element.Key = nil
                                KeyBtn.Text = "None"
                            else
                                Element.Key = key
                                KeyBtn.Text = formatKeyName(key)
                            end
                            binding = false
                        end
                    elseif Element.Key and not UserInputService:GetFocusedTextBox() then
                        if input.KeyCode == Element.Key or input.UserInputType == Element.Key then
                            Element.Value = not Element.Value
                            fire()
                        end
                    end
                end)
            end

            -- Color Picker Logic
            if opts.Color then
                local ColorBtn = Instance.new("TextButton")
                ColorBtn.Size = UDim2.new(0, 24, 0, 16)
                ColorBtn.BackgroundColor3 = Element.Color
                ColorBtn.Text = ""
                ColorBtn.Parent = RightContainer
                Instance.new("UICorner", ColorBtn).CornerRadius = UDim.new(0, 4)
                local cStroke = Instance.new("UIStroke", ColorBtn)
                cStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                cStroke.Color = Color3.new(0,0,0)
                cStroke.Thickness = 1

                ColorBtn.MouseButton1Click:Connect(function()
                    if ColorPopup.Visible and ActiveColorTarget == function() end then
                        ColorPopup.Visible = false
                        return
                    end
                    ColorPopup.Visible = true
                    ColorPopup.Position = UDim2.new(1.05, 0, 0, tglBtn.AbsolutePosition.Y - MainFrame.AbsolutePosition.Y)
                    ActiveColorTarget = function(color)
                        Element.Color = color
                        ColorBtn.BackgroundColor3 = color
                        callback(Element.Value, Element.Color)
                    end
                end)
            end

            function Element:Set(val, col)
                Element.Value = val
                if col and opts.Color then Element.Color = col end
                fire()
            end

            tglBtn.MouseButton1Click:Connect(function()
                Element.Value = not Element.Value
                fire()
            end)
            
            Window.Flags[flag] = Element
            Window:ApplyTheme()
            fire()
            
            return Element
        end

        function Tab:CreateSlider(opts)
            local title = opts.Name or "Slider"
            local desc = opts.Description
            local min = opts.Min or 0
            local max = opts.Max or 100
            local default = opts.Default or min
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end
            local h = desc and 55 or 42

            local sliderFrame = Instance.new("Frame")
            sliderFrame.Size = UDim2.new(1, 0, 0, h)
            sliderFrame.BackgroundTransparency = 0.2
            sliderFrame.Parent = Page
            Instance.new("UICorner", sliderFrame).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(sliderFrame)
            
            table.insert(Window.ThemedElements.Bg, sliderFrame)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            SetupDescription(sliderFrame, title, desc)

            local valLabel = Instance.new("TextLabel")
            valLabel.Size = UDim2.new(0, 40, 0, 20)
            valLabel.Position = UDim2.new(1, -48, 0, desc and 4 or 2)
            valLabel.BackgroundTransparency = 1
            valLabel.Text = tostring(default)
            valLabel.TextSize = 12
            valLabel.TextXAlignment = Enum.TextXAlignment.Right
            valLabel.Parent = sliderFrame
            applyCleanTextSettings(valLabel)
            table.insert(Window.ThemedElements.SubText, valLabel)

            local barBg = Instance.new("Frame")
            barBg.Size = UDim2.new(1, -16, 0, 4)
            barBg.Position = UDim2.new(0, 8, 0, h - 14)
            barBg.BackgroundColor3 = Color3.fromRGB(35, 30, 45)
            barBg.Parent = sliderFrame
            Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

            local barFill = Instance.new("Frame")
            barFill.Size = UDim2.new(0, 0, 1, 0)
            barFill.Parent = barBg
            Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)
            table.insert(Window.ThemedElements.Main, barFill)

            local Element = {Value = default}

            function Element:Set(val)
                Element.Value = math.clamp(val, min, max)
                local pos = (Element.Value - min) / (max - min)
                barFill.Size = UDim2.new(pos, 0, 1, 0)
                valLabel.Text = tostring(Element.Value)
                callback(Element.Value)
            end

            local dragging = false
            local function updateSlider(input)
                local pos = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
                local value = math.floor(min + ((max - min) * pos))
                Element:Set(value)
            end

            barBg.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging = true; updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then updateSlider(input) end
            end)

            Window.Flags[flag] = Element
            Element:Set(default)
            return Element
        end

        function Tab:CreateDropdown(opts)
            local title = opts.Name or "Dropdown"
            local desc = opts.Description
            local options = opts.Options or {}
            local default = opts.Default or options[1]
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end
            local h = desc and 45 or 30

            local ddBtn = Instance.new("TextButton")
            ddBtn.Size = UDim2.new(1, 0, 0, h)
            ddBtn.BackgroundTransparency = 0.2
            ddBtn.Text = ""
            ddBtn.Parent = Page
            Instance.new("UICorner", ddBtn).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(ddBtn)
            
            table.insert(Window.ThemedElements.Bg, ddBtn)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local TitleLbl = SetupDescription(ddBtn, title .. ": " .. tostring(default), desc)

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 0, 20)
            arrow.Position = UDim2.new(1, -25, 0, desc and 4 or 5)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextSize = 11
            arrow.Parent = ddBtn
            applyCleanTextSettings(arrow)
            table.insert(Window.ThemedElements.SubText, arrow)

            local listFrame = Instance.new("ScrollingFrame")
            listFrame.Size = UDim2.new(1, 0, 0, 0)
            listFrame.BackgroundTransparency = 0.2
            listFrame.BorderSizePixel = 0
            listFrame.ScrollBarThickness = 2
            listFrame.Visible = false
            listFrame.ClipsDescendants = true
            listFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
            listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
            listFrame.Parent = Page
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 6)
            local listStroke = makeStroke(listFrame)
            
            table.insert(Window.ThemedElements.Bg, listFrame)
            table.insert(Window.ThemedElements.StrokeMain, listStroke)

            local listLayout = Instance.new("UIListLayout", listFrame)
            listLayout.Padding = UDim.new(0, 2)

            local isOpen = false
            local animInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

            local function close()
                isOpen = false
                arrow.Text = "▼"
                local tween = TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, 0)})
                tween:Play()
                tween.Completed:Once(function() if not isOpen then listFrame.Visible = false end end)
            end

            ddBtn.MouseButton1Click:Connect(function()
                isOpen = not isOpen
                arrow.Text = isOpen and "▲" or "▼"
                if isOpen then
                    listFrame.Size = UDim2.new(1, 0, 0, 0)
                    listFrame.Visible = true
                    TweenService:Create(listFrame, animInfo, {Size = UDim2.new(1, 0, 0, math.clamp(#options * 26, 0, 100))}):Play()
                else
                    close()
                end
            end)

            local Element = {Value = default, Options = options}

            local function populateList()
                for _, child in ipairs(listFrame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for _, opt in ipairs(Element.Options) do
                    local optBtn = Instance.new("TextButton")
                    optBtn.Size = UDim2.new(1, -8, 0, 24)
                    optBtn.BackgroundTransparency = 1
                    optBtn.Text = "  " .. tostring(opt)
                    optBtn.TextSize = 12
                    optBtn.TextXAlignment = Enum.TextXAlignment.Left
                    optBtn.Parent = listFrame
                    applyCleanTextSettings(optBtn)
                    table.insert(Window.ThemedElements.Text, optBtn)

                    optBtn.MouseButton1Click:Connect(function()
                        Element:Set(opt)
                        close()
                    end)
                end
                Window:ApplyTheme()
            end

            function Element:Set(val)
                Element.Value = val
                TitleLbl.Text = "  " .. title .. ": " .. tostring(val)
                callback(Element.Value)
            end

            function Element:Refresh(newOptions)
                Element.Options = newOptions
                populateList()
            end

            populateList()
            Window.Flags[flag] = Element
            Element:Set(default)
            return Element
        end
        return Tab
    end

    function Window:BuildSettingsTab()
        local SettingsTab = self:CreateTab("Settings")
        
        local themesList = {}
        for _, t in ipairs(LunarLib.Themes) do table.insert(themesList, t.Name) end

        SettingsTab:CreateDropdown({
            Name = "Select Theme",
            Description = "Changes the UI colors",
            Options = themesList,
            Default = Window.CurrentTheme.Name,
            Callback = function(selected)
                for i, t in ipairs(LunarLib.Themes) do
                    if t.Name == selected then
                        self.ThemeIndex = i
                        self.CurrentTheme = LunarLib.Themes[i]
                        self:ApplyTheme()
                        break
                    end
                end
            end
        })

        local configNameBox
        local configDropdown
        
        local function getConfigs()
            local list = {}
            if isfolder and isfolder(self.Folder) then
                for _, file in ipairs(listfiles(self.Folder)) do
                    if file:match("%.json$") then
                        table.insert(list, file:match("([^/%\\]+)%.json$"))
                    end
                end
            end
            if #list == 0 then table.insert(list, "None") end
            return list
        end

        if makefolder and not isfolder(self.Folder) then
            makefolder(self.Folder)
        end

        configNameBox = SettingsTab:CreateTextbox({
            Name = "Config Name",
            Description = "Enter a name to save your settings under",
            Placeholder = "Enter name here..."
        })

        SettingsTab:CreateButton({
            Name = "Save Config",
            Description = "Creates a new config file",
            Callback = function()
                local name = configNameBox.Value
                if name == "" then return end
                
                local data = {}
                for flagName, element in pairs(self.Flags) do
                    if flagName ~= "Select Theme" and flagName ~= "Config Name" and flagName ~= "Select Config" then
                        data[flagName] = element.Value
                    end
                end
                
                if writefile then
                    writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(name)
                end
            end
        })

        configDropdown = SettingsTab:CreateDropdown({
            Name = "Select Config",
            Options = getConfigs(),
            Callback = function() end
        })

        SettingsTab:CreateButton({
            Name = "Overwrite Config",
            Description = "Saves your current changes to the selected config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil or name == "" then return end
                
                local data = {}
                for flagName, element in pairs(self.Flags) do
                    if flagName ~= "Select Theme" and flagName ~= "Config Name" and flagName ~= "Select Config" then
                        data[flagName] = element.Value
                    end
                end
                
                if writefile then
                    writefile(self.Folder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(name)
                end
            end
        })

        SettingsTab:CreateButton({
            Name = "Load Config",
            Description = "Loads settings from the selected config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil then return end
                
                local path = self.Folder .. "/" .. name .. ".json"
                if isfile and isfile(path) then
                    local success, decoded = pcall(function()
                        return HttpService:JSONDecode(readfile(path))
                    end)
                    if success and type(decoded) == "table" then
                        for flagName, value in pairs(decoded) do
                            if self.Flags[flagName] then
                                pcall(function()
                                    self.Flags[flagName]:Set(value)
                                end)
                            end
                        end
                    end
                end
            end
        })

        SettingsTab:CreateButton({
            Name = "Delete Config",
            Description = "Permanently removes the selected config",
            Callback = function()
                local name = configDropdown.Value
                if name == "None" or name == nil then return end
                local path = self.Folder .. "/" .. name .. ".json"
                if isfile and isfile(path) and delfile then
                    delfile(path)
                    configDropdown:Refresh(getConfigs())
                    configDropdown:Set(getConfigs()[1])
                end
            end
        })
        
        SettingsTab:CreateButton({
            Name = "Unload UI",
            Description = "Destroys the menu entirely",
            Callback = function()
                ScreenGui:Destroy()
            end
        })
        
        return SettingsTab
    end

    return Window
end

return LunarLib
