    local ActiveColorTarget = nil

    local function UpdateColorPicker(input)
        if not ActiveColorTarget then return end
        local center = Wheel.AbsolutePosition + (Wheel.AbsoluteSize / 2)
        local mousePos = Vector2.new(input.Position.X, input.Position.Y)
        local offset = mousePos - center
        
        local radius = Wheel.AbsoluteSize.X / 2
        local dist = math.clamp(offset.Magnitude, 0, radius)
        
        local angle = math.atan2(offset.Y, offset.X)
        local finalPos = center + Vector2.new(math.cos(angle) * dist, math.sin(angle) * dist)
        
        WheelPicker.Position = UDim2.new(0, finalPos.X - Wheel.AbsolutePosition.X, 0, finalPos.Y - Wheel.AbsolutePosition.Y)
        
        local hue = (angle + math.pi) / (math.pi * 2)
        local sat = dist / radius
        local color = Color3.fromHSV(hue, sat, 1)
        
        ActiveColorTarget(color)
    end

    local colorDragging = false
    Wheel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            colorDragging = true
            UpdateColorPicker(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            colorDragging = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if colorDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            UpdateColorPicker(input)
        end
    end)

    function Window:ApplyTheme()
        local t = self.CurrentTheme
        for _, obj in ipairs(self.ThemedElements.Bg) do if obj then pcall(function() obj.BackgroundColor3 = t.Bg end) end end
        for _, obj in ipairs(self.ThemedElements.Main) do if obj then pcall(function() if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then obj.TextColor3 = t.Main obj.TextStrokeColor3 = t.Main else obj.BackgroundColor3 = t.Main end end) end end
        for _, obj in ipairs(self.ThemedElements.Text) do if obj then pcall(function() if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then obj.TextColor3 = t.Text obj.TextStrokeColor3 = t.Text else obj.BackgroundColor3 = t.Text end end) end end
        for _, obj in ipairs(self.ThemedElements.SubText) do 
            if obj then 
                pcall(function() 
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then obj.TextColor3 = t.SubText obj.TextStrokeColor3 = t.SubText
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then obj.ImageColor3 = t.SubText
                    else obj.BackgroundColor3 = t.SubText end 
                end) 
            end 
        end
        for _, obj in ipairs(self.ThemedElements.StrokeMain) do if obj then pcall(function() obj.Color = t.Main end) end end
        
        for _, data in ipairs(self.ActiveToggles) do
            if data.state then
                data.bg.BackgroundColor3 = t.Main
                data.knob.BackgroundColor3 = Color3.new(1,1,1)
            else
                data.bg.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
                data.knob.BackgroundColor3 = t.SubText
            end
        end
    end

