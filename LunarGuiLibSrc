        if not Window.FirstTab then
            Window.FirstTab = Page
            Page.Visible = true
            TabStroke.Transparency = 0
        end

        TabBtn.MouseButton1Click:Connect(function()
            for _, t in ipairs(Window.Tabs) do
                t.Page.Visible = false
                t.Stroke.Transparency = 0.7
            end
