            table.insert(Window.ThemedElements.Bg, boxFrame)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local box = Instance.new("TextBox")
            box.Size = UDim2.new(1, -16, 1, 0)
            box.Position = UDim2.new(0, 8, 0, 0)
            box.BackgroundTransparency = 1
            box.Text = ""
            box.PlaceholderText = placeholder
            box.TextSize = 13
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.Parent = boxFrame
            applyCleanTextSettings(box)

            table.insert(Window.ThemedElements.Text, box)

            local Element = {Value = ""}
            function Element:Set(val)
                box.Text = tostring(val)
                Element.Value = tostring(val)
                callback(Element.Value)
            end

            box.FocusLost:Connect(function()
                Element.Value = box.Text
                callback(Element.Value)
            end)

            Window.Flags[flag] = Element
            return Element
        end

        function Tab:CreateToggle(opts)
            local title = opts.Name or "Toggle"
            local default = opts.Default or false
            local flag = opts.Flag or title
            local callback = opts.Callback or function() end

            local tglBtn = Instance.new("TextButton")
            tglBtn.Size = UDim2.new(1, 0, 0, 30)
            tglBtn.BackgroundTransparency = 0.2
            tglBtn.Text = "  " .. title
            tglBtn.TextXAlignment = Enum.TextXAlignment.Left
            tglBtn.TextSize = 13
            tglBtn.Parent = Page
            applyCleanTextSettings(tglBtn)

            Instance.new("UICorner", tglBtn).CornerRadius = UDim.new(0, 6)
            local stroke = makeStroke(tglBtn)
            stroke.Transparency = 0.5
            
            table.insert(Window.ThemedElements.Bg, tglBtn)
            table.insert(Window.ThemedElements.Text, tglBtn)
            table.insert(Window.ThemedElements.StrokeMain, stroke)

            local switchBg = Instance.new("Frame")
            switchBg.Size = UDim2.new(0, 32, 0, 16)
            switchBg.Position = UDim2.new(1, -40, 0.5, -8)
            switchBg.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
            switchBg.Parent = tglBtn
            Instance.new("UICorner", switchBg).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 12, 0, 12)
            knob.Position = UDim2.new(0, 2, 0.5, -6)
            knob.Parent = switchBg
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            local Element = {Value = default}
            local tData = {bg = switchBg, knob = knob, state = Element.Value}
            table.insert(Window.ActiveToggles, tData)

            local function fire()
                tData.state = Element.Value
                if Element.Value then
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Window.CurrentTheme.Main}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(1, -14, 0.5, -6), BackgroundColor3 = Color3.new(1,1,1)}):Play()
                else
                    TweenService:Create(switchBg, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 22, 35)}):Play()
                    TweenService:Create(knob, TweenInfo.new(0.2), {Position = UDim2.new(0, 2, 0.5, -6), BackgroundColor3 = Window.CurrentTheme.SubText}):Play()
                end
                callback(Element.Value)
            end

            function Element:Set(val)
                Element.Value = val
                fire()
            end

            tglBtn.MouseButton1Click:Connect(function()
                Element.Value = not Element.Value
                fire()
            end)
            
            Window.Flags[flag] = Element
            Window:ApplyTheme()
            fire()
            
            return Element
        end

