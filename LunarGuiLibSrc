local function makeStroke(parent)
    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Transparency = 0.6
    stroke.Thickness = 1
    stroke.Parent = parent
    return stroke
end

local function makeDraggable(topBar, objectToMove)
    local dragging, dragInput, dragStart, startPos
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = objectToMove.Position
            input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
        end
    end)
    topBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            objectToMove.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
end

function LunarLib:CreateWindow(options)
    options = options or {}
    local WindowTitle = options.Title or "Lunar UI"
    local DefaultTheme = options.Theme or "Midnight"
    local FolderName = options.Folder or "LunarConfigs"
    local WindowSize = options.Size or UDim2.new(0, 280, 0, 360)
    
    local Window = {
        ThemeIndex = 1,
        CurrentTheme = nil,
        ThemedElements = {Bg = {}, Main = {}, Accent = {}, Text = {}, SubText = {}, StrokeMain = {}, TextStroke = {}},
        ActiveToggles = {},
        Tabs = {},
        FirstTab = nil,
        Flags = {}, 
        Folder = FolderName
    }

    -- Moved inside CreateWindow to apply dynamic theme strokes to all text while keeping them unbolded
    local function applyCleanTextSettings(obj)
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            obj.Font = Enum.Font.Gotham -- Using Gotham to keep it looking clean and unbolded
            obj.TextStrokeTransparency = 1
            
            local textStroke = Instance.new("UIStroke")
            textStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Context
            textStroke.Thickness = 0.7 -- Keeps the stroke thin so the text doesn't look bold
            textStroke.Transparency = 0.15
            textStroke.Parent = obj
            
            table.insert(Window.ThemedElements.TextStroke, textStroke)
        end
    end

    for i, t in ipairs(LunarLib.Themes) do
        if t.Name == DefaultTheme then
            Window.ThemeIndex = i
            break
        end
    end
    Window.CurrentTheme = LunarLib.Themes[Window.ThemeIndex] or LunarLib.Themes[1]

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "LunarLibraryUI"
    ScreenGui.ResetOnSpawn = false
    local success = pcall(function() ScreenGui.Parent = CoreGui end)
    if not success then ScreenGui.Parent = Player:WaitForChild("PlayerGui") end
    Window.Gui = ScreenGui

    function Window:ApplyTheme()
        local t = self.CurrentTheme
        for _, obj in ipairs(self.ThemedElements.Bg) do if obj then pcall(function() obj.BackgroundColor3 = t.Bg end) end end
        for _, obj in ipairs(self.ThemedElements.Main) do if obj then pcall(function() if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then obj.TextColor3 = t.Main else obj.BackgroundColor3 = t.Main end end) end end
        for _, obj in ipairs(self.ThemedElements.Text) do if obj then pcall(function() if obj:IsA("TextLabel") or obj:IsA("TextBox") or obj:IsA("TextButton") then obj.TextColor3 = t.Text else obj.BackgroundColor3 = t.Text end end) end end
        
        for _, obj in ipairs(self.ThemedElements.SubText) do 
            if obj then 
                pcall(function() 
                    if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then 
                        obj.TextColor3 = t.SubText 
                    elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
                        obj.ImageColor3 = t.SubText
                    else 
                        obj.BackgroundColor3 = t.SubText 
                    end 
                end) 
            end 
        end
        
        for _, obj in ipairs(self.ThemedElements.StrokeMain) do if obj then pcall(function() obj.Color = t.Main end) end end
        
        -- Applies theme color to the neon text strokes dynamically
        for _, obj in ipairs(self.ThemedElements.TextStroke) do if obj then pcall(function() obj.Color = t.Main end) end end
        
        for _, data in ipairs(self.ActiveToggles) do
            if data.state then
                data.bg.BackgroundColor3 = t.Main
                data.knob.BackgroundColor3 = Color3.new(1,1,1)
            else
                data.bg.BackgroundColor3 = Color3.fromRGB(25, 22, 35)
                data.knob.BackgroundColor3 = t.SubText
            end
        end
    end

